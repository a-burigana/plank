(define (domain gossip)
    (:requirements
        :equality :lists :list-comprehensions :partial-observability
        :general-preconditions :knowing-whether
    )

    (:action-type-libraries intermediate)

    (:predicates (secret ?i - agent))

    (:event nil)

    ;--------------------TELL------------------

    (:event e-tell
        :parameters (?i ?j - agent)
        :precondition (and (secret ?i) (<Kw. ?j> (secret ?i)))
    )

    ; (:action tell
    ;     :parameters (?i ?j - agent | (/= ?i ?j))
    ;     :action-type (private-announcement (e-tell ?i ?j) (nil))
    ;     :observability-conditions
    ;         (:and
    ;             (?i Fully)
    ;             (?j Fully)
    ;             (default Oblivious)
    ;         )
    ; )

    ;------------------TELL-ALL----------------

    (:event e-tell-all
        :parameters (?i - agent)
        :precondition (forall (?k - agent)
            (or
                (imply
                    ([?i] (secret ?k))
                    (secret ?k)
                )
                (imply
                    ([?i] (not (secret ?k)))
                    (not (secret ?k))
                )
            )
        )
    )

    (:action tell-all
        :parameters (?i ?j - agent | (/= ?i ?j))
        :action-type (private-announcement (e-tell-all ?i) (nil))
        :observability-conditions
            (:and
                (?i Fully)
                (?j Fully)
                (default Oblivious)
            )
    )
)
