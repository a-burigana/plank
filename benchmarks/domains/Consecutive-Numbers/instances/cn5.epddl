(define (problem cn-5)
    (:domain consecutive-numbers)

    (:requirements
        :typing :equality :list-comprehensions :facts :finitary-S5-theories
        :disjunctive-list-formulas :modal-goals
    )

    (:objects
        n0 n1 n2 n3 n4 n5 n6 n7 - number
    )

    (:agents A B)

    (:facts-init
        (consecutive n0 n1)
        (consecutive n1 n2)
        (consecutive n2 n3)
        (consecutive n3 n4)
        (consecutive n4 n5)
        (consecutive n5 n6)
        (consecutive n6 n7)
        (assignable A n1) (assignable A n3) (assignable A n5) (assignable A n7)
        (assignable B n0) (assignable B n2) (assignable B n4) (assignable B n6)
    )

    (:init
        (:and
            ; Numbers assignment from agent B's perspective
            (has B n4)
            ; A has an odd number, B has an even number and the numbers are consecutive
            ([C. All]
                (exists (?i ?j - agent ?m ?n - number |
                    (and
                        (assignable ?i ?m) (assignable ?j ?n)
                        (consecutive ?m ?n)
                    ))
                    (and (has ?i ?m) (has ?j ?n))
                )
            )
            ; Agents have at most one number
            ([C. All]
                (forall (?i - agent ?m ?n - number | (/= ?m ?n))
                    (imply (has ?i ?m) (not (has ?i ?n)))
                ))
            ; Agents know their number
            (:forall (?i - agent ?n - number)
                ([C. All]
                    ([Kw. ?i] (has ?i ?n)) ))
        ))

    (:goal
        ([B] ([A] (has B n4)))
    )
)
